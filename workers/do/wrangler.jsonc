{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pwn-labs-do",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LevelSession", "Leaderboard"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LEVEL_SESSION", "class_name": "LevelSession" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" }
    ]
	},
	"env": {
		"staging": {
			"name": "pwn-labs-do-staging",
			"durable_objects": {
				"bindings": [
					{ "name": "LEVEL_SESSION", "class_name": "LevelSession" },
					{ "name": "LEADERBOARD", "class_name": "Leaderboard" }
				]
			}
		}
	}
}
