---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = 'Belajar binary exploitation seperti bermain game. Semua challenge berjalan di browser.' } = Astro.props;
const fullTitle = title ? `${title} | pwn-labs` : 'pwn-labs: belajar binary exploitation di browser';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-bg text-fg antialiased">
		<a
			href="#isi"
			class="absolute left-4 top-4 z-50 -translate-y-24 rounded-base bg-accent px-4 py-3 text-sm text-bg focus:translate-y-0"
			>Lewati ke isi</a
		>
		<Header />
		<main id="isi" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
