---
interface Props {
	title: string;
	body: string;
	href?: string;
	action?: string;
}
const { title, body, href = '/play', action = 'Kembali ke Play' } = Astro.props;
---

<div class="mx-auto max-w-5xl px-5 py-16 md:py-24">
	<h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
	<p class="mt-3 max-w-[56ch] leading-7 text-muted">{body}</p>
	<a
		href={href}
		class="mt-8 inline-block rounded-base border border-border px-5 py-3 text-sm font-medium transition-colors hover:bg-surface"
		>{action}</a
	>
</div>
