---
const links = [
  { href: '/play', label: 'Play' },
  { href: '/docs', label: 'Docs' },
  { href: '/leaderboard', label: 'Leaderboard' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
const user = Astro.locals.user;
---

<header class="border-b border-border bg-bg">
	<div class="mx-auto flex min-h-16 max-w-5xl flex-wrap items-center justify-between gap-x-4 px-5 sm:h-16 sm:flex-nowrap sm:gap-6">
		<a href="/" class="-mx-2 inline-block whitespace-nowrap px-2 py-3 font-mono text-base font-semibold tracking-tight text-fg">pwn-labs</a>
		<nav aria-label="Utama" class="contents sm:flex sm:items-center sm:gap-2">
			<ul class="order-3 -mx-3 flex w-[calc(100%+1.5rem)] items-center justify-between gap-1 border-t border-border text-sm sm:order-none sm:mx-0 sm:w-auto sm:justify-start sm:gap-2 sm:border-0">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								aria-current={isCurrent(l.href) ? 'page' : undefined}
								class="inline-block rounded-base px-3 py-3 text-muted transition-colors hover:text-fg aria-[current=page]:text-fg aria-[current=page]:font-medium"
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
			{
				user ? (
					<a href="/me" aria-label={`Akun ${user.username}`} class="ml-1 flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border bg-surface">
						{user.avatarUrl ? <img src={user.avatarUrl} alt="" class="h-full w-full" referrerpolicy="no-referrer" /> : <span class="text-sm">{user.username.slice(0, 1)}</span>}
					</a>
				) : (
					<a href={`/auth/github?next=${encodeURIComponent(path)}`} class="ml-1 inline-flex min-h-11 items-center rounded-base border border-border px-3 py-2 text-sm font-medium hover:bg-surface">Masuk</a>
				)
			}
		</nav>
	</div>
</header>
