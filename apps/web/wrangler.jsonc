{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "pwn-labs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pwn-labs-db",
			"database_id": "8c940c23-2970-40a3-95d6-b46b5860ac67",
			"migrations_dir": "../../migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "LEVEL_SESSION", "class_name": "LevelSession", "script_name": "pwn-labs-do" },
			{ "name": "LEADERBOARD", "class_name": "Leaderboard", "script_name": "pwn-labs-do" }
		]
	},
	"observability": {
		"enabled": true
	},
	"secrets": {
		"required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "FLAG_SECRET"]
	},
	"env": {
		"staging": {
			"name": "pwn-labs-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pwn-labs-db-staging",
					"database_id": "89e386cd-b644-43f1-8aba-436c35a06dd9",
					"migrations_dir": "../../migrations"
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "LEVEL_SESSION", "class_name": "LevelSession", "script_name": "pwn-labs-do-staging" },
					{ "name": "LEADERBOARD", "class_name": "Leaderboard", "script_name": "pwn-labs-do-staging" }
				]
			},
			"secrets": {
				"required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "FLAG_SECRET"]
			}
		}
	}
}
